{
  "name": "kunstpunkte-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "data:import": "node scripts/import-data.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:smoke": "npm run build && node --test tests/app.smoke.ts"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "24.13.4",
    "entities": "8.1.0",
    "jsdom": "26.1.0",
    "json5": "2.2.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3"
  }
}
